{
  "manifest_version": 3,
  "name": "WebGantt グループウェア調査ツール(一時利用)",
  "version": "1.0.0",
  "description": "社内グループウェア(intra-mart)のスケジュール画面の通信内容・DOM構造を記録する調査専用ツールです。WebGanttのTeams Excel連携拡張機能とは別物で、設計調査完了後は削除して構いません。",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "downloads", "unlimitedStorage"],
  "host_permissions": [
    "http://*.suzumo.local/*",
    "https://*.suzumo.local/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*.suzumo.local/*", "https://*.suzumo.local/*"],
      "js": ["injected.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["http://*.suzumo.local/*", "https://*.suzumo.local/*"],
      "js": ["content_bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
