# ============================================================
# WebGantt 環境変数テンプレート
# ============================================================
# このファイルをコピーして .env として保存し、値を編集してください。
#   cp .env.example .env
#
# .env はリポジトリにコミットせず、必ず .gitignore に含めてください。
#
# 参照方針（PHP バックエンド）:
#   WEBGANTT_DB_HOST → DB_HOST → デフォルト値
#   （WEBGANTT_ プレフィックスが優先。Node WS の既存 DB_* 変数と共有可）
# ============================================================

# ─── DB接続 ────────────────────────────────────────────────
WEBGANTT_DB_HOST=127.0.0.1
WEBGANTT_DB_PORT=3306
WEBGANTT_DB_NAME=gantt_collab
WEBGANTT_DB_USER=gantt_app
WEBGANTT_DB_PASS=change_this_password
WEBGANTT_DB_CHARSET=utf8mb4

# ─── セッション/Cookie ─────────────────────────────────
WEBGANTT_SESSION_LIFETIME=604800
WEBGANTT_SESSION_COOKIE=gantt_session
WEBGANTT_SESSION_PREFIX=gts_
# HTTP 検証中は false。HTTPS 本番では必ず true に。
WEBGANTT_SESSION_COOKIE_SECURE=false
WEBGANTT_SESSION_COOKIE_SAMESITE=Lax

# ─── Node WebSocket サーバー ─────────────────────────
PORT=3001
NODE_ENV=production
# HTTPS 本番では特定オリジンに絞ること（例: https://ogma.mydns.jp）
CLIENT_ORIGIN=*

# ─── アプリの基準パス（参考。実際は HTML の <base> と揃える） ─
# WEBGANTT_APP_BASE=/WebGantt/

# ─── Google カレンダー連携（外部連携機能・docs/google-calendar-import-design.md参照） ─
# Google Cloud Console で発行したOAuthクライアント情報（.envにのみ設定、絶対にコミットしないこと）
WEBGANTT_GOOGLE_CLIENT_ID=
WEBGANTT_GOOGLE_CLIENT_SECRET=
# 承認済みリダイレクトURIと完全一致させること（末尾のスラッシュ有無等も厳密に一致させる）
WEBGANTT_GOOGLE_REDIRECT_URI=https://ogma.mydns.jp/WebGantt/api/calendar_import.php?action=callback
# トークン暗号化鍵（openssl_encrypt/openssl_decrypt AES-256-CBC用）。
# 生成例: php -r "echo bin2hex(random_bytes(32));"
WEBGANTT_TOKEN_ENCRYPTION_KEY=
